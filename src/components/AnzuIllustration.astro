---
interface Props {
  state?: 'welcome' | 'brand' | 'nodes' | 'plans' | 'budget' | 'clients' | 'articles' | 'faq';
  size?: number | string;
  className?: string;
  alt?: string;
}

const {
  state = 'welcome',
  size = 280,
  className = '',
  alt = '杏花云原创品牌向导 杏子 (ANZU)'
} = Astro.props;

const pixelSize = typeof size === 'number' ? `${size}px` : size;
---

<div class={`anzu-character-wrapper ${className}`} style={`--anzu-size: ${pixelSize};`} data-state={state}>
  <img
    src="/assets/images/anzu-brand-card.png"
    alt={alt}
    class="anzu-brand-img"
    loading="lazy"
    decoding="async"
    width="1024"
    height="1024"
  />
</div>

<style>
  .anzu-character-wrapper {
    width: var(--anzu-size);
    height: var(--anzu-size);
    max-width: 100%;
    display: inline-flex;
    justify-content: center;
    align-items: center;
    position: relative;
    user-select: none;
    aspect-ratio: 1 / 1;
    border-radius: 20px;
    overflow: visible;
  }

  .anzu-brand-img {
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    aspect-ratio: 1 / 1;
    object-fit: contain;
    display: block;
    border-radius: inherit;
    box-shadow: 0 8px 24px -4px rgba(169, 80, 112, 0.16);
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
  }

  .anzu-character-wrapper:hover .anzu-brand-img {
    transform: translateY(-4px) scale(1.02);
    box-shadow: 0 14px 32px -4px rgba(169, 80, 112, 0.24);
  }

  @media (prefers-reduced-motion: reduce) {
    .anzu-character-wrapper:hover .anzu-brand-img {
      transform: none;
    }
  }
</style>
