---
interface Props {
  state?: 'welcome' | 'brand' | 'nodes' | 'plans' | 'budget' | 'clients' | 'articles' | 'faq';
  size?: number | string;
  className?: string;
}

const { state = 'welcome', size = 280, className = '' } = Astro.props;
---

<div class={`anzu-character-wrapper ${className}`} style={`--anzu-size: ${typeof size === 'number' ? size + 'px' : size};`}>
  <svg
    viewBox="0 0 320 380"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    class="anzu-svg"
    aria-label={`杏花云原创品牌角色 杏子 (ANZU) - 状态: ${state}`}
    role="img"
  >
    <defs>
      <!-- Gradients -->
      <linearGradient id="hairGrad" x1="160" y1="40" x2="160" y2="280" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#C28498" />
        <stop offset="60%" stop-color="#9C5D72" />
        <stop offset="100%" stop-color="#6F3B4E" />
      </linearGradient>

      <linearGradient id="skinGrad" x1="160" y1="60" x2="160" y2="180" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#FFF5EE" />
        <stop offset="100%" stop-color="#FCE1D4" />
      </linearGradient>

      <linearGradient id="kimonoGrad" x1="160" y1="170" x2="160" y2="360" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#FFFDF9" />
        <stop offset="60%" stop-color="#FFF4F7" />
        <stop offset="100%" stop-color="#F7D8E3" />
      </linearGradient>

      <linearGradient id="sashGrad" x1="100" y1="240" x2="220" y2="280" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#D982A4" />
        <stop offset="50%" stop-color="#A95070" />
        <stop offset="100%" stop-color="#D982A4" />
      </linearGradient>

      <linearGradient id="greenAccent" x1="140" y1="230" x2="180" y2="270" gradientUnits="userSpaceOnUse">
        <stop offset="0%" stop-color="#C6DFC1" />
        <stop offset="100%" stop-color="#526B53" />
      </linearGradient>

      <radialGradient id="blushGrad" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#F4BFD0" stop-opacity="0.6" />
        <stop offset="100%" stop-color="#F4BFD0" stop-opacity="0" />
      </radialGradient>

      <radialGradient id="auraGlow" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#F4BFD0" stop-opacity="0.35" />
        <stop offset="100%" stop-color="#FFF9F0" stop-opacity="0" />
      </radialGradient>

      <!-- Blossom Filter Glow -->
      <filter id="softGlow" x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="6" result="blur" />
        <feComposite in="SourceGraphic" in2="blur" operator="over" />
      </filter>
    </defs>

    <!-- Background Ambient Aura -->
    <circle cx="160" cy="190" r="130" fill="url(#auraGlow)" />
    
    <!-- Floating Petal Ambient Decors -->
    <path d="M70,80 Q76,70 85,74 Q90,83 82,88 Q72,89 70,80 Z" fill="#F4BFD0" opacity="0.6" />
    <path d="M250,90 Q258,82 265,88 Q268,98 259,102 Q250,101 250,90 Z" fill="#F4BFD0" opacity="0.5" />
    <path d="M45,210 Q50,202 58,206 Q62,214 55,218 Q46,218 45,210 Z" fill="#D982A4" opacity="0.4" />
    <path d="M275,220 Q282,214 288,220 Q290,228 282,231 Q274,230 275,220 Z" fill="#D982A4" opacity="0.45" />

    <!-- Long Back Hair -->
    <path d="M110,120 C85,160 70,240 85,320 C100,280 125,230 135,180 Z" fill="url(#hairGrad)" />
    <path d="M210,120 C235,160 250,240 235,320 C220,280 195,230 185,180 Z" fill="url(#hairGrad)" />
    <path d="M120,110 C90,180 80,260 100,340 C130,350 190,350 220,340 C240,260 230,180 200,110 Z" fill="url(#hairGrad)" opacity="0.95" />

    <!-- Torso / Dress Base -->
    <path d="M125,180 L195,180 L225,360 L95,360 Z" fill="url(#kimonoGrad)" stroke="#E5C7D3" stroke-width="1.5" />
    
    <!-- Kimono Collar (Crossed neckline) -->
    <path d="M125,180 L160,230 L195,180" stroke="#D982A4" stroke-width="3" fill="#FFF9F0" />
    <path d="M135,180 L160,220 L185,180" stroke="#C6DFC1" stroke-width="2" fill="none" />

    <!-- Obi Sash (Waist) -->
    <rect x="120" y="235" width="80" height="28" rx="4" fill="url(#sashGrad)" />
    <line x1="120" y1="249" x2="200" y2="249" stroke="#FFF9F0" stroke-width="1.5" stroke-dasharray="3,3" />
    
    <!-- Sage Green Ribbon / Tassel on Obi -->
    <path d="M160,245 C155,255 145,270 148,290" stroke="url(#greenAccent)" stroke-width="3" stroke-linecap="round" fill="none" />
    <path d="M160,245 C165,255 175,270 172,290" stroke="url(#greenAccent)" stroke-width="3" stroke-linecap="round" fill="none" />
    <circle cx="160" cy="245" r="4" fill="#526B53" />

    <!-- Neck & Face -->
    <path d="M148,160 L148,185 L172,185 L172,160 Z" fill="url(#skinGrad)" />
    <!-- Chin & Cheeks -->
    <path d="M124,120 C124,165 145,180 160,180 C175,180 196,165 196,120 C196,85 175,70 160,70 C145,70 124,85 124,120 Z" fill="url(#skinGrad)" />

    <!-- Cheeks Blush -->
    <ellipse cx="138" cy="142" rx="10" ry="5" fill="url(#blushGrad)" />
    <ellipse cx="182" cy="142" rx="10" ry="5" fill="url(#blushGrad)" />

    <!-- Facial Expression - Eyes & Eyebrows (Gentle Adult Anime Style) -->
    <!-- Left Eyebrow -->
    <path d="M134,116 Q144,113 150,117" stroke="#7A4559" stroke-width="2" stroke-linecap="round" fill="none" />
    <!-- Right Eyebrow -->
    <path d="M170,117 Q176,113 186,116" stroke="#7A4559" stroke-width="2" stroke-linecap="round" fill="none" />

    <!-- Left Eye -->
    <ellipse cx="142" cy="128" rx="6.5" ry="8" fill="#542B3A" />
    <ellipse cx="142" cy="129" rx="4.5" ry="6" fill="#8F3D58" />
    <circle cx="140" cy="125" r="2.2" fill="#FFFFFF" />
    <circle cx="144" cy="132" r="1.2" fill="#F4BFD0" />
    <path d="M133,124 Q142,120 150,125" stroke="#493C40" stroke-width="2.2" stroke-linecap="round" fill="none" />

    <!-- Right Eye -->
    <ellipse cx="178" cy="128" rx="6.5" ry="8" fill="#542B3A" />
    <ellipse cx="178" cy="129" rx="4.5" ry="6" fill="#8F3D58" />
    <circle cx="176" cy="125" r="2.2" fill="#FFFFFF" />
    <circle cx="180" cy="132" r="1.2" fill="#F4BFD0" />
    <path d="M170,125 Q178,120 187,124" stroke="#493C40" stroke-width="2.2" stroke-linecap="round" fill="none" />

    <!-- Dainty Nose -->
    <circle cx="160" cy="144" r="1.2" fill="#C48E9E" />

    <!-- Gentle Smile -->
    <path d="M154,156 Q160,161 166,156" stroke="#A95070" stroke-width="2" stroke-linecap="round" fill="none" />

    <!-- Front Bangs & Side Locks -->
    <path d="M120,105 C130,135 132,150 134,165 C136,155 140,135 138,110 Z" fill="url(#hairGrad)" />
    <path d="M200,105 C190,135 188,150 186,165 C184,155 180,135 182,110 Z" fill="url(#hairGrad)" />
    <path d="M124,100 C138,118 152,118 160,105 C168,118 182,118 196,100 C185,82 175,75 160,75 C145,75 135,82 124,100 Z" fill="url(#hairGrad)" />
    <path d="M145,95 Q152,112 155,115 Q158,105 162,95" fill="url(#hairGrad)" />

    <!-- Apricot Blossom Hair Accessory -->
    <g transform="translate(192, 92) scale(0.9)">
      <circle cx="0" cy="-9" r="6" fill="#FFF4F7" stroke="#D982A4" stroke-width="1.2" />
      <circle cx="8" cy="-3" r="6" fill="#FFF4F7" stroke="#D982A4" stroke-width="1.2" />
      <circle cx="5" cy="7" r="6" fill="#FFF4F7" stroke="#D982A4" stroke-width="1.2" />
      <circle cx="-5" cy="7" r="6" fill="#FFF4F7" stroke="#D982A4" stroke-width="1.2" />
      <circle cx="-8" cy="-3" r="6" fill="#FFF4F7" stroke="#D982A4" stroke-width="1.2" />
      <circle cx="0" cy="0" r="4" fill="#F4BFD0" />
      <circle cx="0" cy="0" r="2" fill="#E8B452" />
      <path d="M2,8 C4,16 10,22 12,30" stroke="#C6DFC1" stroke-width="2" stroke-linecap="round" fill="none" />
      <circle cx="12" cy="31" r="2.5" fill="#526B53" />
    </g>

    {/* STATE SPECIFIC PROPS & ARMS */}
    {state === 'welcome' && (
      <g class="state-props">
        <path d="M125,190 C105,210 90,230 75,250 C85,255 105,245 120,230 Z" fill="url(#kimonoGrad)" stroke="#E5C7D3" stroke-width="1.2" />
        <circle cx="75" cy="250" r="7" fill="url(#skinGrad)" />
        <path d="M195,190 C215,210 230,230 245,250 C235,255 215,245 200,230 Z" fill="url(#kimonoGrad)" stroke="#E5C7D3" stroke-width="1.2" />
        <circle cx="245" cy="250" r="7" fill="url(#skinGrad)" />
        <circle cx="65" cy="235" r="2.5" fill="#F4BFD0" />
        <circle cx="255" cy="235" r="2.5" fill="#F4BFD0" />
      </g>
    )}

    {state === 'brand' && (
      <g class="state-props">
        <rect x="200" y="210" width="45" height="60" rx="4" fill="#FFF9F0" stroke="#A95070" stroke-width="2" />
        <line x1="208" y1="222" x2="236" y2="222" stroke="#D982A4" stroke-width="2" />
        <line x1="208" y1="232" x2="236" y2="232" stroke="#526B53" stroke-width="1.5" />
        <line x1="208" y1="242" x2="230" y2="242" stroke="#826D74" stroke-width="1.5" />
        <circle cx="202" cy="240" r="7" fill="url(#skinGrad)" />
        <path d="M125,190 C110,210 115,235 130,245" stroke="#E5C7D3" stroke-width="16" stroke-linecap="round" fill="none" />
        <circle cx="132" cy="245" r="6" fill="url(#skinGrad)" />
      </g>
    )}

    {state === 'nodes' && (
      <g class="state-props">
        <circle cx="225" cy="225" r="28" fill="none" stroke="#C6DFC1" stroke-width="1.8" stroke-dasharray="4,3" />
        <circle cx="225" cy="225" r="18" fill="none" stroke="#D982A4" stroke-width="1.5" />
        <circle cx="218" cy="216" r="3" fill="#A95070" />
        <circle cx="236" cy="218" r="3" fill="#526B53" />
        <circle cx="220" cy="234" r="3" fill="#D982A4" />
        <circle cx="238" cy="232" r="3" fill="#C6DFC1" />
        <path d="M195,190 C205,210 215,230 220,245" stroke="#E5C7D3" stroke-width="14" stroke-linecap="round" fill="none" />
        <circle cx="220" cy="246" r="6" fill="url(#skinGrad)" />
      </g>
    )}

    {state === 'plans' && (
      <g class="state-props">
        <rect x="215" y="200" width="50" height="42" rx="6" fill="#FFF4F7" stroke="#D982A4" stroke-width="2" />
        <text x="222" y="218" font-size="11" font-weight="bold" fill="#A95070">¥3/月</text>
        <text x="222" y="232" font-size="8" fill="#526B53">12元年付</text>
        <path d="M195,190 C210,210 220,230 225,240" stroke="#E5C7D3" stroke-width="14" stroke-linecap="round" fill="none" />
        <circle cx="225" cy="242" r="6" fill="url(#skinGrad)" />
      </g>
    )}

    {state === 'budget' && (
      <g class="state-props">
        <rect x="70" y="210" width="45" height="55" rx="5" fill="#E3EEDF" stroke="#526B53" stroke-width="1.8" />
        <rect x="75" y="216" width="35" height="12" rx="2" fill="#FFF9F0" />
        <text x="80" y="225" font-size="8" font-family="monospace" fill="#526B53">0.012¥</text>
        <circle cx="80" cy="235" r="2.5" fill="#A95070" />
        <circle cx="92" cy="235" r="2.5" fill="#A95070" />
        <circle cx="104" cy="235" r="2.5" fill="#A95070" />
        <circle cx="80" cy="245" r="2.5" fill="#526B53" />
        <circle cx="92" cy="245" r="2.5" fill="#526B53" />
        <circle cx="104" cy="245" r="2.5" fill="#526B53" />
        <path d="M125,190 C110,210 100,230 95,245" stroke="#E5C7D3" stroke-width="14" stroke-linecap="round" fill="none" />
        <circle cx="95" cy="246" r="6" fill="url(#skinGrad)" />
      </g>
    )}

    {state === 'clients' && (
      <g class="state-props">
        <rect x="205" y="205" width="46" height="30" rx="3" fill="#FFF9F0" stroke="#526B53" stroke-width="1.6" />
        <line x1="200" y1="237" x2="256" y2="237" stroke="#526B53" stroke-width="2" stroke-linecap="round" />
        <path d="M228,212 L236,215 L236,222 C236,226 228,230 228,230 C228,230 220,226 220,222 L220,215 Z" fill="#D982A4" />
        <rect x="65" y="220" width="22" height="38" rx="4" fill="#FFF9F0" stroke="#A95070" stroke-width="1.6" />
        <circle cx="76" cy="252" r="2" fill="#D982A4" />
      </g>
    )}

    {state === 'articles' && (
      <g class="state-props">
        <path d="M125,230 C140,225 155,230 160,234 C165,230 180,225 195,230 L195,260 C180,255 165,260 160,264 C155,260 140,255 125,260 Z" fill="#FFFDF9" stroke="#A95070" stroke-width="1.8" />
        <line x1="160" y1="234" x2="160" y2="264" stroke="#D982A4" stroke-width="1.5" />
        <line x1="133" y1="238" x2="152" y2="238" stroke="#526B53" stroke-width="1.2" />
        <line x1="133" y1="244" x2="152" y2="244" stroke="#826D74" stroke-width="1" />
        <line x1="168" y1="238" x2="187" y2="238" stroke="#526B53" stroke-width="1.2" />
        <line x1="168" y1="244" x2="187" y2="244" stroke="#826D74" stroke-width="1" />
      </g>
    )}

    {state === 'faq' && (
      <g class="state-props">
        <circle cx="235" cy="185" r="16" fill="#FFF4F7" stroke="#D982A4" stroke-width="1.8" />
        <text x="231" y="191" font-size="16" font-weight="bold" fill="#A95070">?</text>
        <path d="M195,190 C205,200 215,205 220,205" stroke="#E5C7D3" stroke-width="12" stroke-linecap="round" fill="none" />
        <circle cx="220" cy="206" r="6" fill="url(#skinGrad)" />
      </g>
    )}
  </svg>
</div>

<style>
  .anzu-character-wrapper {
    width: var(--anzu-size);
    display: inline-flex;
    justify-content: center;
    align-items: center;
    position: relative;
    user-select: none;
  }

  .anzu-svg {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 8px 18px rgba(169, 80, 112, 0.12));
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .anzu-character-wrapper:hover .anzu-svg {
    transform: translateY(-4px) scale(1.02);
  }

  @media (prefers-reduced-motion: reduce) {
    .anzu-character-wrapper:hover .anzu-svg {
      transform: none;
    }
  }
</style>
