---
import Layout from '../layouts/Layout.astro';
import plansData from '../data/pricing.json';
import brandData from '../data/brand.json';
import faqsData from '../data/faqs.json';
import AnzuIllustration from '../components/AnzuIllustration.astro';
import AnzuPlanAdvisor from '../components/AnzuPlanAdvisor.astro';
import TrafficCalculator from '../components/TrafficCalculator.astro';

const affiliateUrl = brandData.affiliateUrl;
const pageTitle = "杏花云机场 - Clash机场订阅、全球代理节点与客户端指南";
const pageDesc = "了解杏花云机场XingHua Cloud的Clash订阅、VLESS协议、全球代理节点及客户端指南。提供12元年付、3元月付、1000GB专业版及365天流量包资料、套餐价格对比与购买入口。";

// Build FAQPage Schema from the 36 FAQs
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqsData.map(f => ({
    '@type': 'Question',
    'name': f.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': f.answer
    }
  }))
};
---

<Layout
  title={pageTitle}
  description={pageDesc}
  canonicalPath="/"
  jsonLd={faqJsonLd}
  showIntro={true}
>
  <!-- HERO SECTION -->
  <section class="hero-section" id="hero-section">
    <div class="hero-inner container">
      <div class="hero-content">
        <div class="hero-badge-row">
          <span class="blossom-badge">🌸 Blossom Girl MAX · 日系治愈美学</span>
          <span class="hero-en-tag">{brandData.heroEnglish}</span>
        </div>

        <h1 class="hero-h1">{brandData.heroH1}</h1>
        <div class="hero-visual-title">{brandData.visualTitle}</div>
        <p class="hero-slogan">与杏花少女一起，开启属于你的云端旅程。</p>
        <div class="hero-subline">{brandData.heroSubtitle}</div>

        <p class="hero-prose">
          杏花云（XingHua Cloud）以高性价比全球网络连接、VLESS协议及灵活流量订阅为核心，为日常浏览、学习办公、人工智能应用及多平台设备提供多样化网络服务选择。从每年12元的经济型套餐，到每月1000GB的专业版方案，以及365天一次性流量包，用户可以根据自身预算、设备数量与使用需求选择适合自己的网络连接方案。跟随杏花少女的云端旅程，轻松了解套餐价格、节点订阅、Clash客户端兼容性及网络配置知识。
        </p>

        <!-- 4 Action Buttons -->
        <div class="hero-actions">
          <a href="#pricing-plans" class="btn-primary">
            <span>查看杏花套餐</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg>
          </a>
          <a href="#plan-advisor" class="btn-secondary btn-soft-green">
            <span>🌸 智能推荐套餐</span>
          </a>
          <a href="/clients/" class="btn-secondary">
            <span>Clash使用指南</span>
          </a>
          <a
            href={affiliateUrl}
            target="_blank"
            rel={brandData.affiliateRel}
            class="btn-primary"
            style="background: linear-gradient(135deg, #A95070 0%, #8F3D58 100%);"
          >
            <span>立即购买</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        </div>

        <!-- 6 Hero Key Stats -->
        <div class="hero-stats-grid">
          <div class="hero-stat-card">
            <span class="stat-num">¥3<small>/月起</small></span>
            <span class="stat-label">灵活月付轻量版</span>
          </div>
          <div class="hero-stat-card">
            <span class="stat-num">¥12<small>/年起</small></span>
            <span class="stat-label">入门年付（折合¥1/月）</span>
          </div>
          <div class="hero-stat-card">
            <span class="stat-num">1000<small>GB/月</small></span>
            <span class="stat-label">专业版大流量资料</span>
          </div>
          <div class="hero-stat-card">
            <span class="stat-num">¥20<small>/次</small></span>
            <span class="stat-label">365天1000GB流量包</span>
          </div>
          <div class="hero-stat-card">
            <span class="stat-num">2–5<small>台</small></span>
            <span class="stat-label">多设备并发支持</span>
          </div>
          <div class="hero-stat-card">
            <span class="stat-num">VLESS</span>
            <span class="stat-label">轻量高效核心协议</span>
          </div>
        </div>
      </div>

      <!-- Hero Character Illustration -->
      <div class="hero-character-box">
        <div class="hero-anzu-card">
          <AnzuIllustration state="welcome" size={310} />
          <div class="anzu-caption">
            <span class="c-name">🌸 杏子 (ANZU)</span>
            <span class="c-desc">杏花云原创品牌向导</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CHAPTER 01: STORY & BRAND INTRODUCTION -->
  <section class="story-section container" id="brand-story">
    <div class="section-header">
      <span class="blossom-badge sub-tag">01 · 春日杏花序幕</span>
      <h2>认识杏花云，开启轻盈的全球网络旅程</h2>
      <p>
        在数字网络已深度融入日常生活的今天，获取稳定、实惠且低门槛的网络连接不应成为繁琐的负担。杏花云以“轻量连接、高性价比、透明消费”为愿景，让每一位用户都能以最轻松的姿态畅游世界网络。
      </p>
    </div>

    <div class="story-article-card blossom-card">
      <div class="story-grid">
        <div class="story-text">
          <p>
            杏花云（XingHua Cloud）诞生于对现代网络预算与使用效率的深度观察。随着远程协作、跨境学术查阅与多终端协同的普及，许多用户面临着“订阅费用昂贵、流量过剩浪费、配置极其复杂”的现实痛点。杏花云以平价轻量为基石，通过现代化 VLESS 网络协议与科学的流量分级方案，重新定义了经济型网络连接标准。
          </p>
          <p>
            在品牌视觉上，我们融入了春日杏花、暖阳奶油白与草木浅绿的日系自然美学，并设计了独立品牌角色「杏子 · ANZU」。她将化身为您的网络旅程伙伴，从客户端的选择、协议的兼容性排查，到各套餐每GB理论成本测算，陪伴您理性消费，找到真正契合自身的网络连接方式。
          </p>
          <div class="brand-veracity-note">
            📌 <strong>信息真实性声明：</strong> 杏花云创立时间暂未公开，本站不编造任何虚假企业发展历史与专线宣传。全站所有关于节点、协议、价格及客户端兼容性均严格基于商家公开资料整理收录，以供用户做出客观参考。
          </div>
        </div>
        <div class="story-side-illo">
          <AnzuIllustration state="brand" size={260} />
        </div>
      </div>
    </div>
  </section>

  <!-- CHAPTER 02: 6 CORE ADVANTAGES -->
  <section class="story-section container" id="brand-advantages">
    <div class="section-header">
      <span class="blossom-badge sub-tag">02 · 六大核心优势</span>
      <h2>六大核心服务优势，探索高性价比数字生活</h2>
      <p>从超低入门月费到千GB大流量，从现代协议到多端适配，杏花云为您提供扎实均衡的网络基础服务。</p>
    </div>

    <div class="advantages-grid">
      {brandData.advantages.map((adv) => (
        <div class="adv-card blossom-card">
          <div class="adv-top">
            <span class="adv-index">{adv.id}</span>
            <span class="blossom-badge blossom-badge-green">{adv.tag}</span>
          </div>
          <h3 class="adv-title">{adv.title}</h3>
          <p class="adv-desc">{adv.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- CHAPTER 03: USAGE SCENARIOS -->
  <section class="story-section container" id="usage-scenarios">
    <div class="section-header">
      <span class="blossom-badge sub-tag">03 · 多元场景连接</span>
      <h2>从AI办公到高清视频，多样化网络使用场景</h2>
      <p>无论您是专注学术研究、日常协同办公，还是影音娱乐追剧，都能找到合适的连接节奏。</p>
    </div>

    <div class="scenarios-grid">
      <div class="scenario-card blossom-card">
        <div class="s-icon">🤖</div>
        <h3>主流 AI 工具交互协同</h3>
        <p>支持日常访问主流国际人工智能对话工具（如 ChatGPT、Claude、Perplexity 等），适合文本生成、编程辅助与学术检索。</p>
        <span class="scenario-tip">推荐节点：美国、日本、新加坡</span>
      </div>
      <div class="scenario-card blossom-card">
        <div class="s-icon">🎬</div>
        <h3>高清流媒体视听娱乐</h3>
        <p>提供大容量月度流量支持，满足 YouTube 1080P/4K 高清视听、Netflix 剧集及国际流行音乐串流的日常娱乐需求。</p>
        <span class="scenario-tip">推荐套餐：标准版（500GB）或专业版（1000GB）</span>
      </div>
      <div class="scenario-card blossom-card">
        <div class="s-icon">💼</div>
        <h3>轻度远程办公与跨国协同</h3>
        <p>支持 GitHub 代码拉取、海外文献检索、Google Docs 多人协作与跨境视频会议，多设备协同保持随时在线。</p>
        <span class="scenario-tip">推荐节点：中国香港（超低延迟）</span>
      </div>
      <div class="scenario-card blossom-card">
        <div class="s-icon">📱</div>
        <h3>手机与电脑双端日常备用</h3>
        <p>针对偶尔查阅资讯、备用网络应急或低频差旅的用户，提供低门槛年付与365天流量包，不浪费任何一分钱。</p>
        <span class="scenario-tip">推荐方案：年付50G 或 365天流量包</span>
      </div>
    </div>
  </section>

  <!-- CHAPTER 04: GLOBAL BLOSSOM GARDEN -->
  <section class="story-section container" id="global-nodes">
    <div class="section-header">
      <span class="blossom-badge sub-tag">04 · 全球网络花园</span>
      <h2>杏花云全球代理节点与地区连接指南</h2>
      <p>收录中国香港、日本、新加坡与美国四大核心区域节点资料，根据地理位置与业务特点灵活分流。</p>
    </div>

    <div class="garden-map-card blossom-card blossom-card-green">
      <div class="garden-grid">
        <div class="garden-nodes-list">
          {brandData.nodes.map((n) => (
            <div class="node-item">
              <div class="node-item-head">
                <span class="node-flag">🌸</span>
                <span class="node-name">{n.name}</span>
                <span class="node-region-tag">{n.region}</span>
              </div>
              <div class="node-delay">{n.delay}</div>
              <p class="node-desc">{n.desc}</p>
              <div class="node-fit">🎯 适用：{n.suitableFor}</div>
            </div>
          ))}
        </div>
        <div class="garden-side-info">
          <AnzuIllustration state="nodes" size={240} />
          <div class="garden-notice">
            <h4>💡 节点选择建议</h4>
            <p>
              日常网页浏览与即时通讯优先选择<strong>中国香港</strong>；流媒体娱乐推荐<strong>日本</strong>；国际云服务与跨境接口推荐<strong>新加坡</strong>；AI 工具使用与大文件下载推荐<strong>美国</strong>。
            </p>
            <p class="garden-warn">
              * 注：延迟数据为基于地理物理距离之理论范围，由于网络运营商路由与晚高峰波动，请以客户端本地实时 Ping 值为准。
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CHAPTER 05: 6 PRICING PLANS -->
  <section class="story-section container" id="pricing-plans">
    <div class="section-header">
      <span class="blossom-badge sub-tag">05 · 六款杏花套餐</span>
      <h2>杏花云机场套餐价格与六款流量方案</h2>
      <p>建立统一数据源，提供年付50G、年付100G、轻量版、标准版、专业版及365天流量包完整对比。</p>
    </div>

    <!-- Cycle Filter Tabs -->
    <div class="plans-filter-bar">
      <button type="button" class="plan-tab active" data-filter="all">全部方案 (6)</button>
      <button type="button" class="plan-tab" data-filter="monthly">支持月付 (3)</button>
      <button type="button" class="plan-tab" data-filter="yearly">经济年付 (5)</button>
      <button type="button" class="plan-tab" data-filter="one-time">一次性流量包 (1)</button>
    </div>

    <div class="plans-grid">
      {plansData.map((plan) => (
        <div class={`plan-card blossom-card ${plan.id === 'standard' ? 'plan-card-featured' : ''}`} data-type={plan.trafficType} data-cycles={plan.availableCycles.join(',')}>
          <div class="plan-top-badge">
            <span class="plan-theme-name">🌸 {plan.visualTheme}</span>
            <span class="plan-badge-pill">{plan.badge}</span>
          </div>

          <h3 class="plan-name">{plan.name}</h3>
          <div class="plan-traffic-highlight">{plan.trafficDisplay}</div>

          <!-- Dynamic Price Display -->
          <div class="plan-price-row">
            {plan.id === 'annual-50g' && (
              <div class="price-box">
                <span class="price-val">¥12</span>
                <span class="price-unit">/ 年</span>
                <span class="price-sub">折合 ¥1/月 · 每GB仅需 ¥0.020</span>
              </div>
            )}
            {plan.id === 'annual-100g' && (
              <div class="price-box">
                <span class="price-val">¥24</span>
                <span class="price-unit">/ 年</span>
                <span class="price-sub">折合 ¥2/月 · 每GB仅需 ¥0.020</span>
              </div>
            )}
            {plan.id === 'lightweight' && (
              <div class="price-box">
                <span class="price-val">¥3</span>
                <span class="price-unit">/ 月起</span>
                <span class="price-sub">季付¥9 / 半年¥18 / 年付¥36 (¥0.015/GB)</span>
              </div>
            )}
            {plan.id === 'standard' && (
              <div class="price-box">
                <span class="price-val">¥6</span>
                <span class="price-unit">/ 月起</span>
                <span class="price-sub">季付¥18 / 半年¥36 / 年付¥72 (¥0.012/GB)</span>
              </div>
            )}
            {plan.id === 'pro' && (
              <div class="price-box">
                <span class="price-val">¥10</span>
                <span class="price-unit">/ 月起</span>
                <span class="price-sub">年付参考区间 ¥90–120 (¥0.0075–0.0100/GB)</span>
              </div>
            )}
            {plan.id === 'traffic-pack-365' && (
              <div class="price-box">
                <span class="price-val">¥20</span>
                <span class="price-unit">/ 次</span>
                <span class="price-sub">365天有效期内总计 1000GB (¥0.020/GB)</span>
              </div>
            )}
          </div>

          <p class="plan-desc">{plan.description}</p>

          <ul class="plan-features-list">
            {plan.features.map((feat) => (
              <li>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#526B53" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>{feat}</span>
              </li>
            ))}
          </ul>

          <div class="plan-cta-box">
            <a
              href={affiliateUrl}
              target="_blank"
              rel={brandData.affiliateRel}
              class="btn-primary plan-buy-btn"
              data-plan-name={plan.name}
              data-plan-price={plan.id === 'annual-50g' ? '¥12/年' : plan.id === 'annual-100g' ? '¥24/年' : plan.id === 'lightweight' ? '¥3/月' : plan.id === 'standard' ? '¥6/月' : plan.id === 'pro' ? '¥10/月' : '¥20/次'}
              data-plan-cycle={plan.defaultCycle}
            >
              <span>立即选购</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CHAPTER 06: HOW TO CHOOSE PLANS -->
  <section class="story-section container" id="how-to-choose">
    <div class="section-header">
      <span class="blossom-badge sub-tag">06 · 选型建议</span>
      <h2>50GB至1000GB，杏花云套餐应该怎么选？</h2>
      <p>按照设备数量与月度实际使用需求对号入座，避免低估断网或过度冗余。</p>
    </div>

    <div class="guide-grid">
      <div class="guide-card blossom-card">
        <h3>1. 极低预算与轻量体验（50G–100G）</h3>
        <p>如果您平时仅在手机上查阅维基百科、偶尔翻译网页、查收海外邮件，每月 50GB 至 100GB 绰绰有余。年付 12 元或 24 元相当于每天花费仅需几分钱，是备用连接与轻度学习用户的极致选择。</p>
      </div>
      <div class="guide-card blossom-card">
        <h3>2. 灵活测试与日常办公（轻量版 200G）</h3>
        <p>新用户建议优先尝试月付 3 元的轻量版。每月 200GB 能够充分满足日常网页浏览、社交媒体互动与主流 AI 工具交互。按月支付没有任何沉没成本，体验满意后再考虑升级或长期订阅。</p>
      </div>
      <div class="guide-card blossom-card">
        <h3>3. 绝大多数人的平衡首选（标准版 500G）</h3>
        <p>如果您喜欢在 YouTube 观看 1080P 高清视频，或者经常参与线上视频协作，标准版（¥6/月）提供 500GB 充沛容量与 3 台设备配额，在流量规模与支出预算之间取得了绝佳的平衡。</p>
      </div>
      <div class="guide-card blossom-card">
        <h3>4. 多设备重度极客（专业版 1000G）</h3>
        <p>如果拥有 4–5 台设备（如手机、电脑、平板、NAS 或全家共享），且频繁观看 4K 超高清视频或下载大容量数据集，专业版（¥10/月）的 1000GB 月流量能够彻底告别流量告急的顾虑。</p>
      </div>
    </div>
  </section>

  <!-- CHAPTER 07: 365-DAY PACK VS PERIODIC PLANS -->
  <section class="story-section container" id="traffic-pack-section">
    <div class="section-header">
      <span class="blossom-badge sub-tag">07 · 一次性流量深度辨析</span>
      <h2>365天1000GB流量包与周期套餐有什么区别？</h2>
      <p>认清计费周期与流量消耗模式的差异，不做盲目消费者。</p>
    </div>

    <div class="pack-comparison-card blossom-card">
      <div class="table-responsive">
        <table class="blossom-table">
          <thead>
            <tr>
              <th>对比维度</th>
              <th>365天流量包（四季花境）</th>
              <th>专业版周期套餐（千花盛放）</th>
              <th>标准版周期套餐（杏花庭院）</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>流量计算逻辑</strong></td>
              <td><span class="text-cta">365天内总计 1000GB</span>（用完即止）</td>
              <td>每月重置 1000GB（全年共计 12,000GB）</td>
              <td>每月重置 500GB（全年共计 6,000GB）</td>
            </tr>
            <tr>
              <td><strong>支付模式</strong></td>
              <td>一次性支付 ¥20 / 次</td>
              <td>月付 ¥10 / 年付参考区间 ¥90–120</td>
              <td>月付 ¥6 / 年付 ¥72</td>
            </tr>
            <tr>
              <td><strong>有效期限</strong></td>
              <td>自购买起 365 天（非永久不限时）</td>
              <td>按月/按年持续有效，每月清零重置</td>
