---
import Layout from '../../layouts/Layout.astro';
import AnzuIllustration from '../../components/AnzuIllustration.astro';

const pageTitle = "杏花云原创阅读中心｜Clash使用指南、节点购买与网络知识";
const pageDesc = "杏花云原创技术阅读与评测中心。汇聚2026 Clash机场推荐、节点购买风险防范、稳定订阅选型、Clash Verge实操、Mihomo内核及不限设备真相六大深度专题。";
const affiliateUrl = "https://varnexa.lingdongaff.com/#/?code=dNrfos55";

const articles = [
  {
    id: 13,
    slug: 'clash-airport-client-selection-2026',
    title: '2026 Clash机场推荐｜按客户端、VLESS订阅与设备需求选择机场',
    shortTitle: '2026 Clash机场推荐',
    category: '客户端与选型',
    date: '2026-11-18',
    readTime: '8 分钟 (1,620字)',
    desc: '从客户端生态、Mihomo内核与VLESS协议匹配切入，深度测评Windows、macOS与移动设备上的订阅体验，并对比杏花云六款套餐的实际适用场景。',
    tags: ['Clash机场推荐', 'Mihomo内核', 'VLESS订阅', '设备匹配']
  },
  {
    id: 14,
    slug: 'clash-node-purchase-guide',
    title: 'Clash节点购买指南｜订阅格式、流量套餐与节点选择注意事项',
    shortTitle: 'Clash节点购买指南',
    category: '购买指南与风险',
    date: '2026-11-15',
    readTime: '8 分钟 (1,660字)',
    desc: '全面解析单节点与订阅服务的本质区别、公共免费节点的隐私泄露风险、VLESS协议与YAML配置格式，以及订阅密钥防盗刷安全规范。',
    tags: ['Clash节点购买', '订阅格式', '流量套餐', '密钥安全']
  },
  {
    id: 15,
    slug: 'stable-clash-subscription',
    title: '稳定Clash订阅推荐2026｜订阅更新、节点质量与连接稳定性分析',
    shortTitle: '稳定Clash订阅推荐2026',
    category: '稳定性与测速',
    date: '2026-11-12',
    readTime: '9 分钟 (1,710字)',
    desc: '科学拆解网络延迟、丢包率与晚高峰国际骨干拥堵对连接稳定性的影响，破除虚假测速图表迷信，建立一套行之有效的日常节点排查机制。',
    tags: ['稳定Clash订阅', '晚高峰测试', '网络延迟', '丢包排查']
  },
  {
    id: 16,
    slug: 'clash-verge-airport-guide',
    title: 'Clash Verge机场推荐｜Clash Verge Rev客户端与VLESS订阅指南',
    shortTitle: 'Clash Verge机场推荐',
    category: '客户端实操',
    date: '2026-11-10',
    readTime: '8 分钟 (1,630字)',
    desc: '聚焦目前最受推崇的开源跨平台客户端 Clash Verge Rev，深度讲解其对 VLESS 协议的原生支持、Tun 虚拟网卡配置与常见报错排查技巧。',
    tags: ['Clash Verge', 'Clash Verge Rev', 'VLESS配置', 'Tun模式']
  },
  {
    id: 17,
    slug: 'clash-meta-node-guide',
    title: 'Clash Meta节点推荐｜Mihomo内核、VLESS协议与全球节点选择',
    shortTitle: 'Clash Meta节点推荐',
    category: '内核进阶技术',
    date: '2026-11-06',
    readTime: '9 分钟 (1,680字)',
    desc: '深入剖析 Mihomo（Clash Meta）内核在协议解析与规则集（Rule Provider）分流上的强大能力，对比香港、日本、新加坡及美国节点在不同业务下的表现。',
    tags: ['Clash Meta', 'Mihomo内核', '规则分流', '全球节点']
  },
  {
    id: 18,
    slug: 'unlimited-device-airport-guide',
    title: '不限设备机场推荐指南｜2台、3台、5台与不限设备套餐如何选择',
    shortTitle: '不限设备机场推荐指南',
    category: '设备真相与选型',
    date: '2026-11-02',
    readTime: '8 分钟 (1,650字)',
    desc: '深度拆解“不限设备”宣传背后的流量超卖与限速隐性规则，厘清在线并发设备与注册设备的本质区别，客观评估杏花云 2台/3台/5台 设备套餐的性价比。',
    tags: ['不限设备机场', '设备限制', '并发连接', '多端协同']
  }
];

const articlesJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  'name': pageTitle,
  'description': pageDesc,
  'url': 'https://xinghuayun.buzz/articles/',
  'hasPart': articles.map(a => ({
    '@type': 'Article',
    'headline': a.title,
    'url': `https://xinghuayun.buzz/articles/${a.slug}/`,
    'datePublished': a.date,
    'description': a.desc
  }))
};
---

<Layout
  title={pageTitle}
  description={pageDesc}
  canonicalPath="/articles/"
  jsonLd={articlesJsonLd}
>
  <div class="articles-center-wrap">
    <!-- Breadcrumbs -->
    <nav class="breadcrumb-nav container" aria-label="面包屑导航">
      <ol class="breadcrumb-list">
        <li><a href="/">首页</a></li>
        <li class="separator">/</li>
        <li class="current">原创阅读中心</li>
      </ol>
    </nav>

    <!-- Header Hero -->
    <header class="articles-hero container">
      <div class="articles-tag-row">
        <span class="blossom-badge">🌸 杏花云智库</span>
        <span class="articles-sub-en">ORIGINAL TECHNICAL ESSAYS</span>
      </div>
      <h1 class="articles-h1">杏花云原创阅读中心</h1>
      <p class="articles-lead">
        拒绝空洞参数堆砌，坚守技术真实性。六篇高信息密度原创专题，助您明晰客户端内核、规避购买陷阱、理性规划流量与设备预算。
      </p>
    </header>

    <!-- Main List -->
    <div class="articles-grid-container container">
      <div class="articles-catalog-grid">
        {articles.map((art) => (
          <article class="article-catalog-card blossom-card">
            <div class="card-meta-top">
              <span class="category-badge">{art.category}</span>
              <span class="article-date">{art.date}</span>
            </div>

            <h2 class="card-title">
              <a href={`/articles/${art.slug}/`}>{art.title}</a>
            </h2>

            <p class="card-desc">{art.desc}</p>

            <div class="card-tags-row">
              {art.tags.map((tag) => (
                <span class="tag-pill">#{tag}</span>
              ))}
            </div>

            <div class="card-footer-row">
              <span class="read-time">📖 {art.readTime}</span>
              <a href={`/articles/${art.slug}/`} class="read-btn">
                阅读全文 →
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Anzu Reading Guide Card -->
      <div class="reading-anzu-card blossom-card">
        <div class="anzu-read-inner">
          <div class="anzu-read-face">
            <AnzuIllustration state="articles" size={140} />
          </div>
          <div class="anzu-read-text">
            <h3>🌸 杏子的选读小贴士</h3>
            <p>
              “如果您刚接触 Clash，建议先从<strong>第16篇《Clash Verge机场推荐》</strong>开始熟悉软件操作；如果您正在纠结该买多少流量或几台设备，不妨阅读<strong>第18篇《不限设备机场推荐指南》</strong>并搭配首页的<strong>流量预算计算器</strong>哦！”
            </p>
            <div class="anzu-read-links">
              <a href="/clients/" class="btn-secondary" style="font-size: 13px;">访问客户端中心</a>
              <a href="/#pricing-plans" class="btn-primary" style="font-size: 13px;">查看全部套餐</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .articles-center-wrap {
    padding-bottom: 60px;
  }

  .breadcrumb-nav {
    padding-top: 24px;
    padding-bottom: 12px;
  }

  .breadcrumb-list {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13.5px;
    color: var(--color-text-muted);
  }

  .breadcrumb-list a { color: var(--color-text-muted); }
  .breadcrumb-list a:hover { color: var(--color-cta); }
  .breadcrumb-list .current { color: var(--color-cta); font-weight: 600; }

  .articles-hero {
    margin-top: 16px;
    margin-bottom: 40px;
    text-align: center;
    max-width: 860px;
  }

  .articles-tag-row {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }

  .articles-sub-en {
    font-size: 11.5px;
    font-weight: 700;
    color: var(--color-forest-green);
    letter-spacing: 0.2em;
  }

  .articles-h1 {
    font-size: clamp(26px, 3.6vw, 38px);
    color: var(--color-cta);
    margin-bottom: 14px;
    font-family: var(--font-serif);
  }

  .articles-lead {
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-text-main);
  }

  /* Catalog Grid */
  .articles-catalog-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 28px;
    margin-bottom: 40px;
  }

  .article-catalog-card {
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    background: #FFFFFF;
  }

  .card-meta-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
  }

  .category-badge {
    font-size: 11px;
    font-weight: 700;
    background: var(--color-bg-tint);
    color: var(--color-cta);
    padding: 3px 8px;
    border-radius: var(--radius-full);
  }

  .article-date {
    font-size: 12px;
    color: var(--color-text-muted);
  }

  .card-title {
    font-size: 18.5px;
    line-height: 1.45;
    margin-bottom: 12px;
  }

  .card-title a {
    color: var(--color-text-main);
    transition: color 0.2s ease;
  }

  .card-title a:hover {
    color: var(--color-cta);
  }

  .card-desc {
    font-size: 14px;
    line-height: 1.68;
    color: var(--color-text-muted);
    margin-bottom: 18px;
    flex: 1;
  }

  .card-tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 18px;
  }

  .tag-pill {
    font-size: 11.5px;
    color: var(--color-forest-green);
    background: var(--color-green-card);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
  }

  .card-footer-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 14px;
    border-top: 1px dashed var(--color-border-subtle);
  }

  .read-time {
    font-size: 12px;
    color: var(--color-text-muted);
  }

  .read-btn {
    font-size: 13.5px;
    font-weight: 700;
    color: var(--color-cta);
  }

  .read-btn:hover {
    color: var(--color-cta-hover);
    padding-left: 3px;
  }

  /* Anzu Card */
  .reading-anzu-card {
    padding: 28px 32px;
    background: linear-gradient(135deg, #FFF9F0 0%, #FFF4F7 100%);
    border: 1.5px solid var(--color-sakura-pink);
  }

  .anzu-read-inner {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .anzu-read-text h3 {
    font-size: 18px;
    color: var(--color-cta);
    margin-bottom: 8px;
  }

  .anzu-read-text p {
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--color-text-main);
    margin-bottom: 16px;
  }

  .anzu-read-links {
    display: flex;
    gap: 12px;
  }

  @media (max-width: 860px) {
    .articles-catalog-grid {
      grid-template-columns: 1fr;
    }
    .anzu-read-inner {
      flex-direction: column;
      text-align: center;
    }
    .anzu-read-links {
      justify-content: center;
    }
  }
</style>
