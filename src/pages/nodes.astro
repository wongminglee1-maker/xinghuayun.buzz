---
import Layout from '../layouts/Layout.astro';
import brandData from '../data/brand.json';
import AnzuIllustration from '../components/AnzuIllustration.astro';

const pageTitle = "杏花云全球代理节点｜香港、日本、新加坡与美国节点指南";
const pageDesc = "杏花云全球代理节点全景指南。收录中国香港、日本、新加坡与美国核心节点资料，详解物理延迟、VLESS协议特性、科学分流线路选择与真实稳定性测速方法。";
const affiliateUrl = brandData.affiliateUrl;

const nodesJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  'name': pageTitle,
  'description': pageDesc,
  'url': 'https://xinghuayun.buzz/nodes/',
  'breadcrumb': {
    '@type': 'BreadcrumbList',
    'itemListElement': [
      {
        '@type': 'ListItem',
        'position': 1,
        'name': '首页',
        'item': 'https://xinghuayun.buzz/'
      },
      {
        '@type': 'ListItem',
        'position': 2,
        'name': '全球节点',
        'item': 'https://xinghuayun.buzz/nodes/'
      }
    ]
  }
};
---

<Layout
  title={pageTitle}
  description={pageDesc}
  canonicalPath="/nodes/"
  jsonLd={nodesJsonLd}
>
  <div class="nodes-page-wrapper">
    <!-- Breadcrumbs -->
    <nav class="breadcrumb-nav container" aria-label="面包屑导航">
      <ol class="breadcrumb-list">
        <li><a href="/">首页</a></li>
        <li class="separator">/</li>
        <li class="current">全球节点</li>
      </ol>
    </nav>

    <!-- Header Hero -->
    <header class="nodes-hero container">
      <div class="nodes-hero-badge">
        <span class="blossom-badge blossom-badge-green">🌸 全球连接花园 · 节点指南</span>
        <span class="hero-tech-sub">GLOBAL NETWORK TOPOLOGY MANUAL</span>
      </div>
      <h1 class="nodes-h1">杏花云全球网络节点与云端连接花园</h1>
      <p class="nodes-lead">
        根据地理位置与骨干光缆走向，收录中国香港、日本、新加坡及美国四大核心出海区域资料。基于科学的物理延迟模型与现代 VLESS 协议分流规则，助您理性选择最契合业务的节点连接方案。
      </p>
    </header>

    <div class="nodes-main-content container">
      <!-- Section 1: Hand-Drawn Map & Regional Cards -->
      <section class="nodes-section blossom-card blossom-card-green">
        <div class="garden-map-header">
          <div class="gm-title-row">
            <span class="blossom-badge">🌸 亚太与北美节点布局</span>
            <h2>四大核心地区收录资料卡</h2>
          </div>
          <p class="gm-desc">
            杏花云节点以中国大陆周边优质骨干与北美核心带宽机房为主，以下为基于商家公开收录的地区信息。
          </p>
        </div>

        <div class="garden-grid">
          <div class="garden-nodes-list">
            {brandData.nodes.map((n) => (
              <div class="node-card-item">
                <div class="node-head">
                  <div class="node-title-group">
                    <span class="node-blossom-pin">🌸</span>
                    <span class="node-name">{n.name}</span>
                  </div>
                  <span class="node-region-tag">{n.region}</span>
                </div>
                <div class="node-delay-bar">
                  <span class="delay-icon">⚡</span>
                  <span class="delay-text">{n.delay}</span>
                </div>
                <p class="node-desc">{n.desc}</p>
                <div class="node-fit">
                  <strong>🎯 推荐应用：</strong>{n.suitableFor}
                </div>
              </div>
            ))}
          </div>

          <div class="garden-side-panel">
            <div class="side-illo-center">
              <AnzuIllustration state="nodes" size={240} />
            </div>
            <div class="garden-notice-box">
              <h4>💡 杏子的节点选择小贴士</h4>
              <p>
                “不同网络活动对节点的要求各不相同：查阅资料和文字聊天优先选<strong>香港</strong>，延迟最低；看番剧和4K高清推荐<strong>日本</strong>；调取国际API与办公选<strong>新加坡</strong>；与AI大模型对话或下载大文件选<strong>美国</strong>最省心！”
              </p>
              <div class="truth-pill">
                📌 延迟数据为基于地理光缆物理距离之理论范围，晚高峰请以客户端实时 Ping 为准。
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 2: Physical Distance & Latency Relationship -->
      <section class="nodes-section blossom-card">
        <div class="section-title-wrap">
          <span class="blossom-badge">物理科学常识</span>
          <h2>节点地理位置与网络延迟的客观规律</h2>
        </div>
        <p class="section-intro">
          在网络通信中，“延迟（Latency / Ping）”是由光信号在海底光缆与陆地光纤中的传播速度、路由节点交换跳数及物理距离决定的。没有任何技术能够突破光速物理极限：
        </p>

        <div class="latency-table-wrap">
          <table class="blossom-table">
            <thead>
              <tr>
                <th>节点地区</th>
                <th>距大陆物理直线距离</th>
                <th>理论光缆往返 RTT</th>
                <th>晚高峰典型体验</th>
                <th>核心应用场景</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>中国香港 (HK)</strong></td>
                <td>毗邻广东沿海 (~100–1,200 km)</td>
                <td>20ms – 50ms</td>
                <td>毫秒级响应，几乎无感知</td>
                <td>中文搜索、远程桌面、高频网页交互</td>
              </tr>
              <tr>
                <td><strong>日本东京/大阪 (JP)</strong></td>
                <td>~1,800 – 3,000 km</td>
                <td>45ms – 85ms</td>
                <td>平稳流畅，亚太直连</td>
                <td>YouTube 4K、Netflix亚太区、动漫视听</td>
              </tr>
              <tr>
                <td><strong>新加坡 (SG)</strong></td>
                <td>~3,500 – 4,500 km</td>
                <td>55ms – 95ms</td>
                <td>国际出海口，路由规范</td>
                <td>国际商务办公、Slack、跨国协作</td>
              </tr>
              <tr>
                <td><strong>美国西海岸 (US)</strong></td>
                <td>跨太平洋 (~9,000 – 11,000 km)</td>
                <td>135ms – 190ms</td>
                <td>由于跨洋传播，略有微小等待感</td>
                <td>ChatGPT、Claude、GitHub代码、开源镜像</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- Section 3: VLESS Protocol Details -->
      <section class="nodes-section blossom-card">
        <div class="section-title-wrap">
          <span class="blossom-badge blossom-badge-green">协议核心架构</span>
          <h2>杏花云 VLESS 协议节点的技术优势与内核匹配</h2>
        </div>
        <div class="two-col-grid">
          <div class="col-content">
            <p>
              杏花云节点采用新一代 <strong>VLESS（VMess Less）</strong> 传输协议。相较于传统老旧协议，VLESS 的核心优势体现在：
            </p>
            <ul class="styled-feature-list">
              <li><strong>无状态与零冗余加密：</strong> VLESS 本身不自带复杂的对称加密层，而是完全依赖现代底层 TLS 1.3 / XTLS 加密。大幅降低了路由器与手机 CPU 的算力开销，减少发热与电量消耗。</li>
              <li><strong>纯净的握手指令：</strong> 数据传输中消除了传统 VMess 协议固有的时间戳依赖与繁杂的哈希计算，提升并发处理吞吐量。</li>
              <li><strong>商家宣称全节点 1 倍率：</strong> 在计费规则上，杏花云宣称各节点均按照 1:1 实际流量消耗计费，无 3 倍或 5 倍高倍率扣费陷阱（最终请以客户端订阅内节点倍率标签为准）。</li>
            </ul>
          </div>
          <div class="col-tip-box">
            <div class="tip-card-inner">
              <h4>⚠️ 重要内核兼容性提醒</h4>
              <p>
                传统旧版 Clash 内核（由 Dreamacro 原维护版本已停止开发）原生缺少对 VLESS 协议的解析支持，直接导入可能出现“不支持的代理协议”报错。
              </p>
              <p>
                推荐搭配搭载 <strong>Mihomo（前身 Clash.Meta）</strong> 内核的现代客户端（如 Clash Verge Rev、Mihomo Party、Sing-box 等），方可顺利识别与使用。
              </p>
              <a href="/clients/" class="btn-secondary" style="font-size: 13px; margin-top: 8px;">查阅 Clash 客户端配置指南 →</a>
            </div>
          </div>
        </div>
      </section>

      <!-- Section 4: Testing & Stability Criteria -->
      <section class="nodes-section blossom-card">
        <div class="section-title-wrap">
          <span class="blossom-badge">实操排错与测速</span>
          <h2>破除测速迷信：如何科学判断节点稳定性？</h2>
        </div>
        <div class="testing-guide-grid">
          <div class="test-guide-card">
            <div class="tg-num">01</div>
            <h3>不迷信Speedtest峰值跑分</h3>
            <p>
              短时间内的单线程跑满几百兆并不代表日常体验良好。许多测速节点拥有特殊的并发缓存加速，而用户真正需要的是在晚高峰（20:00–23:00）期间持续不丢包、不转圈的稳定连接。
            </p>
          </div>
          <div class="test-guide-card">
            <div class="tg-num">02</div>
            <h3>关注丢包率（Packet Loss）</h3>
            <p>
              延迟高几十毫秒往往不会造成明显卡顿，但若丢包率超过 5%，会导致网页加载阻塞、图片加载失败以及视频频繁缓冲。可通过客户端连续 Ping 测试查看丢包情况。
            </p>
          </div>
          <div class="test-guide-card">
            <div class="tg-num">03</div>
            <h3>合理配置智能分流（Rule模式）</h3>
            <p>
              在 Clash Verge 或其他客户端中保持开启「规则（Rule）」模式，确保中国大陆网站与应用（如微信、淘宝、Bilibili）走直连通道，避免本地请求消耗代理配额。
            </p>
          </div>
          <div class="test-guide-card">
            <div class="tg-num">04</div>
            <h3>晚高峰自动节点切换备用</h3>
            <p>
              当某一地区节点受国际海缆突发事件影响出现抖动时，在客户端分组面板中一键切换至备用地区（例如将香港临时切换为日本或新加坡），即可迅速恢复畅快网络。
            </p>
          </div>
        </div>
      </section>

      <!-- Section 5: Truth & Scope Disclaimer -->
      <section class="nodes-section blossom-card veracity-notice-card">
        <div class="section-title-wrap">
          <span class="blossom-badge">诚信披露</span>
          <h2>节点收录资料真实性与声明</h2>
        </div>
        <div class="veracity-content">
          <p>
            1. <strong>已有收录与实时节点区分：</strong> 本页面所展示的香港、日本、新加坡及美国节点资料系根据杏花云商家公开发布的基础地区信息进行整理收录。不同批次订阅中节点具体名称、出口 IP 段及可用状态可能发生动态调整，请以个人控制台订阅拉取的实时节点列表为准。
          </p>
          <p>
            2. <strong>不虚构服务器运行状态：</strong> 本站不虚报“99.999% 在线率”、“全天候 0 抖动专线”、“独享千兆物理专线”等无法经由第三方实时核验的数据指标。网络连接受本地运营商（电信/联通/移动）国际出口拥堵及国际海缆维护影响，属于正常公网通信客观现象。
          </p>
        </div>
      </section>

      <!-- Bottom Action CTA -->
      <div class="nodes-bottom-cta blossom-card">
        <div class="nb-inner">
          <div class="nb-text">
            <h3>探索多地区节点的高性价比订阅方案</h3>
            <p>杏花云全系套餐均支持上述全部节点地区接入，最低年付仅需 ¥12，月付低至 ¥3。</p>
          </div>
          <div class="nb-btns">
            <a href="/pricing/" class="btn-secondary">查看套餐方案</a>
            <a href={affiliateUrl} target="_blank" rel="sponsored nofollow noopener noreferrer" class="btn-primary">
              前往官方收银台 →
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .nodes-page-wrapper {
    padding-bottom: 70px;
  }

  .breadcrumb-nav {
    padding-top: 24px;
    padding-bottom: 12px;
  }

  .breadcrumb-list {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13.5px;
    color: var(--color-text-muted);
  }

  .breadcrumb-list a {
    color: var(--color-text-muted);
  }

  .breadcrumb-list a:hover {
    color: var(--color-cta);
  }

  .breadcrumb-list .current {
    color: var(--color-cta);
    font-weight: 600;
  }

  .nodes-hero {
    text-align: center;
    margin-top: 16px;
    margin-bottom: 40px;
    max-width: 900px;
  }

  .nodes-hero-badge {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .hero-tech-sub {
    font-size: 11px;
    font-weight: 700;
    color: var(--color-forest-green);
    letter-spacing: 0.12em;
  }

  .nodes-h1 {
    font-size: clamp(24px, 3.6vw, 38px);
    color: var(--color-cta);
    margin-bottom: 16px;
    font-family: var(--font-serif);
    line-height: 1.35;
  }

  .nodes-lead {
    font-size: clamp(15px, 1.8vw, 17px);
    line-height: 1.85;
    color: var(--color-text-main);
    max-width: 780px;
    margin: 0 auto;
  }

  .nodes-main-content {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  .nodes-section {
    padding: 36px 40px;
    background: #FFFFFF;
  }

  .blossom-card-green {
    background: #FCFDFB;
    border: 1.5px solid rgba(82, 107, 83, 0.25);
  }

  .garden-map-header {
    margin-bottom: 28px;
  }

  .gm-title-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 8px;
  }

  .gm-title-row h2 {
    font-size: 21px;
    color: var(--color-forest-green);
    margin: 0;
  }

  .gm-desc {
    font-size: 14.5px;
    color: var(--color-text-muted);
    margin: 0;
  }

  .garden-grid {
    display: grid;
    grid-template-columns: 1.35fr 0.85fr;
    gap: 32px;
    align-items: start;
  }

  .garden-nodes-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .node-card-item {
    background: #FFFFFF;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    padding: 20px;
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .node-card-item:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .node-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
  }

  .node-title-group {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .node-blossom-pin {
    font-size: 18px;
  }

  .node-name {
    font-size: 16px;
    font-weight: 700;
    color: var(--color-text-main);
  }

  .node-region-tag {
    font-size: 11px;
    background: var(--color-bg-tint);
    color: var(--color-cta);
    padding: 2px 8px;
    border-radius: var(--radius-full);
    font-weight: 600;
  }

  .node-delay-bar {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12.5px;
    font-weight: 700;
    color: var(--color-forest-green);
    background: #F3F8F2;
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    margin-bottom: 10px;
  }

  .node-desc {
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--color-text-main);
    margin-bottom: 10px;
  }

  .node-fit {
    font-size: 12.5px;
    color: var(--color-text-muted);
  }

  .garden-side-panel {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .side-illo-center {
    display: flex;
    justify-content: center;
  }

  .garden-notice-box {
    background: #FFFDF9;
    border: 1px solid rgba(217, 130, 164, 0.25);
    border-radius: var(--radius-md);
    padding: 20px;
  }

  .garden-notice-box h4 {
    font-size: 15px;
    color: var(--color-cta);
    margin-bottom: 8px;
  }

  .garden-notice-box p {
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--color-text-main);
    margin-bottom: 12px;
  }

  .truth-pill {
    font-size: 12px;
    color: var(--color-text-muted);
    background: rgba(0, 0, 0, 0.03);
    padding: 6px 10px;
    border-radius: var(--radius-sm);
    line-height: 1.5;
  }

  .section-title-wrap {
    margin-bottom: 18px;
  }

  .section-title-wrap h2 {
    font-size: 21px;
    color: var(--color-text-main);
    margin-top: 8px;
    font-family: var(--font-serif);
  }

  .section-intro {
    font-size: 15px;
    line-height: 1.8;
    color: var(--color-text-main);
    margin-bottom: 22px;
  }

  .latency-table-wrap {
    overflow-x: auto;
  }

  .blossom-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13.5px;
  }

  .blossom-table th, .blossom-table td {
    padding: 12px 14px;
    border-bottom: 1px solid var(--color-border-subtle);
    text-align: left;
  }

  .blossom-table th {
    background: #FFF4F7;
    color: var(--color-cta);
    font-weight: 700;
  }

  .two-col-grid {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: 28px;
  }

  .col-content p {
    font-size: 15px;
    line-height: 1.8;
    color: var(--color-text-main);
    margin-bottom: 16px;
  }

  .styled-feature-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-left: 0;
  }

  .styled-feature-list li {
    font-size: 14px;
    line-height: 1.75;
    position: relative;
    padding-left: 20px;
    color: var(--color-text-main);
  }

  .styled-feature-list li::before {
    content: '🌸';
    position: absolute;
    left: 0;
    top: 3px;
    font-size: 12px;
  }

  .col-tip-box {
    background: #FFFDF9;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    padding: 22px;
  }

  .tip-card-inner h4 {
    font-size: 15px;
    color: #C73866;
    margin-bottom: 10px;
  }

  .tip-card-inner p {
    font-size: 13.5px;
    line-height: 1.7;
    color: var(--color-text-main);
    margin-bottom: 12px;
  }

  .testing-guide-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }

  .test-guide-card {
    background: #FFFDF9;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    padding: 22px;
    position: relative;
  }

  .tg-num {
    font-size: 22px;
    font-weight: 800;
    color: var(--color-soft-green);
    font-family: var(--font-serif);
    margin-bottom: 6px;
  }

  .test-guide-card h3 {
    font-size: 16px;
    color: var(--color-text-main);
    margin-bottom: 8px;
